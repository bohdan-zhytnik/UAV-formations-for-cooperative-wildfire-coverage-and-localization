<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="default">
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.397743</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <!-- Fleet startup speed: 1 simulated second per 2 real seconds.
           Configuration notes: ../tmux_fleet/README.md -->
      <real_time_factor>0.25</real_time_factor>
    </physics>
    <atmosphere type="adiabatic">
      <temperature>293.15</temperature>
      <temperature_gradient>0</temperature_gradient>
