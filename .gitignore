# Generated colcon/CMake output if this package is built in place.
/build/
/install/
/log/
/logs/
/devel/
/.colcon/
/.catkin_tools/

# Python bytecode, virtual environments and tool caches.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Regenerated by prepare.py / prepare_fleet.py; contains local install paths.
/tmux/runtime/
/tmux_fleet/runtime/

# Raw snapshots, validation runs, debug logs and source backups from testing.
# Keep selected publishable figures/results under docs/ instead.
/artifacts/
*.log

# ROS recordings and PX4 flight logs. Store large datasets separately.
rosbag2_*/
/bags/
/recordings/
*.bag
*.bag.active
*.db3
*.db3-shm
*.db3-wal
*.mcap
*.ulg
*.px4log

# Built libraries, crash dumps and container binaries are not source code.
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
/core
/core.[0-9]*
*.sif
*.simg
*.img

# Editor/OS temporary files. Keep deliberate editor launch/task configuration.
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db

# Keep src/, scripts/ (including tests), launch/, config/, models/, worlds/,
# ROMFS/, tmux/*.rviz, tmux_fleet/*.rviz and docs/ under version control.
