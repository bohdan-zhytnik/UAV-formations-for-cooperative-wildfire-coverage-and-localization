Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /uav1 (blue)1
    - /uav2 (green)1
    Splitter Ratio: 0.7235293984413147
  Tree Height: 209
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 5
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 50
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 1
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Value: true
    Topic:
      Value: /fire_fleet/fire_map/markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Name: 'Shared fire map: IDs, boundaries, temperatures and ellipses'
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Mission routes, search areas and active tasks
    Topic:
      Value: /fire_fleet/mission/markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Value: true
  - Class: rviz_common/Group
    Name: uav1 (blue)
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: uav1 pose and camera footprints
      Enabled: true
      Value: true
      Topic:
        Value: /fire_fleet/uav1/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: uav1 accepted destination
      Enabled: true
      Value: true
      Topic:
        Value: /fire_fleet/uav1/goal_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: uav1 flight trail
      Enabled: true
      Value: true
      Topic:
        Value: /fire_fleet/uav1/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 30; 100; 255
      Alpha: 1.0
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: uav1 raw camera observations (optional)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fire_fleet/uav1/observation_markers
      Value: false
  - Class: rviz_common/Group
    Name: uav2 (green)
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: uav2 pose and camera footprints
      Enabled: true
      Value: true
      Topic:
        Value: /fire_fleet/uav2/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: uav2 accepted destination
      Enabled: true
      Value: true
      Topic:
        Value: /fire_fleet/uav2/goal_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: uav2 flight trail
      Enabled: true
      Value: true
      Topic:
        Value: /fire_fleet/uav2/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 30; 190; 65
      Alpha: 1.0
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: uav2 raw camera observations (optional)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fire_fleet/uav2/observation_markers
      Value: false
  - Class: fire_observation_demo/FleetImage
    Name: RGB downward
    Enabled: true
    Value: true
    Topic:
      Value: /uav1/rgb_down/image_raw
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  - Class: fire_observation_demo/FleetImage
    Name: Thermal and fire detection (290-650 K)
    Enabled: true
    Value: true
    Topic:
      Value: /fire_fleet/uav1/detection_image
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  - Class: fire_observation_demo/FleetImage
    Name: RGB downward | uav2
    Enabled: true
    Value: true
    Topic:
      Value: /uav2/rgb_down/image_raw
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  - Class: fire_observation_demo/FleetImage
    Name: Thermal and fire detection (290-650 K) | uav2
    Enabled: true
    Value: true
    Topic:
      Value: /fire_fleet/uav2/detection_image
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: common_origin
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  - Class: fire_observation_demo/FleetGoal
  - Class: fire_observation_demo/SurveyRegion
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 6
        Y: 1
        Z: 1
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.95
      Target Frame: common_origin
      Value: Orbit (rviz)
      Yaw: 4.71
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1450
  X: 30
  Y: 40
  QMainWindow State: 
  RGB downward:
    collapsed: false
  Thermal downward (290-650 K):
    collapsed: false
  Thermal and fire detection (290-650 K):
    collapsed: false
